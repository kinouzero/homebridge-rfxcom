{
  "pluginAlias": "RFXCom",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "required": [
      "name",
      "rfyRemotes"
    ],
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "RFXCom"
      },
      "tty": {
        "title": "Serial device",
        "type": "string",
        "default": "/dev/ttyUSB0"
      },
      "debug": {
        "title": "Debug mode",
        "type": "boolean",
        "default": false
      },
      "rfyRemotes": {
        "title": "Devices",
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "deviceID"
          ],
          "properties": {
            "name": {
              "title": "Device name",
              "description": "Exact device name shown in HomeKit, without an added suffix.",
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "placeholder": "Living room"
            },
            "deviceID": {
              "title": "Device ID",
              "description": "Exact RFY address/unit code registered in the RFXtrx.",
              "type": "string",
              "pattern": "^0x(?!0+/)(?:0[0-9A-Fa-f]{5}|[0-9A-Fa-f]{1,5})/[0-4]$",
              "placeholder": "0x000001/1"
            },
            "reverse": {
              "title": "Reverse direction",
              "description": "When enabled, movement toward 100% sends Down and movement toward 0% sends Up.",
              "type": "boolean",
              "default": false
            },
            "upSeconds": {
              "title": "Full upward travel duration (seconds)",
              "description": "Full travel duration for the RFY Up direction, independent of reverse.",
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 25
            },
            "downSeconds": {
              "title": "Full downward travel duration (seconds)",
              "description": "Full travel duration for the RFY Down direction, independent of reverse.",
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 25
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
