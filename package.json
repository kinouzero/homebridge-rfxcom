{
  "displayName": "RFXCom",
  "name": "@kinouzero/homebridge-rfxcom-2",
  "version": "2.0.0",
  "description": "Homebridge plugin for RFXtrx433(E, XL) transceivers.",
  "license": "MIT License",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinouzero/homebridge-rfxcom.git"
  },
  "bugs": {
    "url": "https://github.com/kinouzero/homebridge-rfxcom/issues"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "homebridge": "^2.4.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "watch": "npm run build && nodemon",
    "build": "node scripts/clean.cjs && tsc",
    "prepublishOnly": "npm run check",
    "test": "npm run build && node --test test/*.test.cjs",
    "check": "npm run lint && npm test",
    "test:coverage": "npm run build && node scripts/coverage.cjs",
    "check:package": "npm run build && node scripts/check-package.cjs",
    "test:native": "npm run build && node --test test/native.test.cjs"
  },
  "keywords": [
    "homebridge-plugin",
    "rfxcom",
    "rfxtrx",
    "rfxtrx433",
    "rfxtrx433e",
    "433",
    "somfy",
    "simu",
    "rts",
    "rfy",
    "homebridge",
    "homekit",
    "window",
    "blinds",
    "awning",
    "remote"
  ],
  "dependencies": {
    "rfxcom": "^2.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
